<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="is_account_view_partner_property_form" model="ir.ui.view">
            <field name="name">is_account_view_partner_property_form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet[1]" position="inside">
                    <style>
                        .o_form_label{
                            white-space: nowrap;
                        }
                    </style>
                </xpath>
                <!-- En v20, la TVA est dans le bloc des identifiants : ancré sur ce bloc -->
                <div name="identifiers" position="after">
                    <field name="is_gestion_colisage"/>
                </div>
                <field name="property_account_receivable_id" position="after">
                    <field name="is_code_comptable_client"/>
                </field>
                <field name="property_account_payable_id" position="after">
                    <field name="is_code_comptable_fournisseur"/>
                </field>

                <xpath expr="//page[@name='sales_purchases']/group/group/field[@name='user_id']" position="before">
                    <field name="is_emplacement_charge_id"/>
                </xpath>

            </field>





        </record>
        <!-- Mobile et civilité : supprimés d'Odoo en v20, remis dans le module -->
        <record id="is_view_partner_form" model="ir.ui.view">
            <field name="name">is_view_partner_form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='phone']/.." position="after">
                    <label for="mobile" class="d-md-none"/>
                    <div class="d-flex align-items-baseline w-md-50 gap-2">
                        <i class="oi oi-filled d-none d-md-inline-flex" data-icon="smartphone" title="Mobile"/>
                        <field name="mobile" widget="phone" placeholder="Mobile"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='function']" position="before">
                    <field name="is_civilite" invisible="is_company" options="{'no_open': True}"/>
                </xpath>
                <xpath expr="//field[@name='child_ids']/form//field[@name='phone']/.." position="after">
                    <label for="mobile" class="d-md-none"/>
                    <div class="d-flex align-items-baseline w-md-50 gap-2">
                        <i class="oi oi-filled d-none d-md-block" data-icon="smartphone" title="Mobile"/>
                        <field name="mobile" widget="phone" placeholder="Mobile"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='child_ids']/form//h3" position="before">
                    <label for="is_civilite" class="d-md-none" invisible="type != 'contact'"/>
                    <div class="w-md-50" invisible="type != 'contact'">
                        <field name="is_civilite" placeholder="Civilité" options="{'no_open': True}"/>
                    </div>
                </xpath>
            </field>
        </record>
        <record id="is_view_partner_tree" model="ir.ui.view">
            <field name="name">is_view_partner_tree</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree" />
            <field name="arch" type="xml">
                <!-- Plus de colonne active en v20 : en fin de liste -->
                <field name="phone" position="after">
                    <field name="mobile" class="o_force_ltr" optional="show"/>
                </field>
                <list position="inside">
                    <field name="is_code_comptable_client"      optional="hide"/>
                    <field name="is_code_comptable_fournisseur" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Civilités -->
        <record id="is_civilite_tree_view" model="ir.ui.view">
            <field name="name">is_civilite_tree_view</field>
            <field name="model">is.civilite</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name" />
                    <field name="shortcut" />
                </list>
            </field>
        </record>
        <record id="is_civilite_action" model="ir.actions.act_window">
            <field name="name">Civilités</field>
            <field name="res_model">is.civilite</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>