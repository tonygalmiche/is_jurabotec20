<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Migration v20 : la page du devis v16 (remplacée en entier) est abandonnée au profit du devis standard,
         complété ici avec les mêmes ajouts et les mêmes éléments masqués qu'en v16 -->
    <template id="is_report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <!-- Titre de la v16 -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="is_proforma">Facture Proforma n° </span>
                <span t-elif="doc.state in ['draft','sent']">Devis n° </span>
                <span t-else="">Confirmation de commande n° </span>
                <span t-field="doc.name"/>
            </t>
        </xpath>

        <!-- Styles du rapport (report.scss) -->
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class" add="jurabotec" separator=" "/>
        </xpath>

        <!-- Informations : libellé de la v16 pour la référence client ; masqués en v16 : expiration, incoterm, date de
             livraison ; ajoutés : délai et n° de commande du client -->
        <xpath expr="//div[@name='informations_reference']/strong" position="replace">
            <strong>Code client</strong>
        </xpath>
        <xpath expr="//div[@name='expiration_date']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.incoterm']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@name='delivery_date']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="doc.is_delai" class="col" name="is_delai">
                <strong>Délai</strong>
                <div t-field="doc.is_delai" t-options='{"widget": "date"}'/>
            </div>
            <div t-if="doc.is_num_cde_client" class="col" name="is_num_cde_client">
                <strong>Ref. Cde client</strong>
                <div t-field="doc.is_num_cde_client"/>
            </div>
        </xpath>

        <!-- Colonne N° palette si une ligne en a un ; masquée en v16 : colonne TVA -->
        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t t-set="affiche_palette" t-value="any(l.is_num_palette for l in lines_to_report)"/>
        </xpath>
        <xpath expr="//t[@t-set='display_taxes']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <!-- Titres des colonnes désignation et quantité (vides dans le devis standard v20) -->
        <xpath expr="//th[@name='th_description']" position="inside">Désignation</xpath>
        <xpath expr="//th[@name='th_quantity']" position="inside">Quantité</xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th t-if="affiche_palette" name="th_is_num_palette" class="text-center">
                <t t-set="colspan_count" t-value="colspan_count + 1"/>
                N°Palette
            </th>
        </xpath>
        <xpath expr="//td[@name='td_product_name']" position="after">
            <td t-if="affiche_palette" name="td_is_num_palette" class="text-center">
                <span t-field="line.is_num_palette"/>
            </td>
        </xpath>

        <!-- Détail des lignes : quantités, prix au tarif, composants, éco-contribution -->
        <xpath expr="//td[@name='td_product_name']//div[hasclass('o_product_name_cell')]" position="inside">
            <div t-if="line.is_detail_quantite" t-field="line.is_detail_quantite"/>
            <div t-if="line.is_prix_tarif and line.is_unite_tarif and line.is_unite_tarif!='unite'">
                Soit <span t-field="line.is_prix_tarif"/> € HT / <span t-field="line.is_unite_tarif"/>
            </div>
            <div t-if="doc.is_detail_composants" t-field="line.is_composants"/>
            <div t-if="line.is_eco_contribution"><i>(Eco-contribution de <span t-field="line.is_eco_contribution"/>)</i></div>
        </xpath>

        <!-- Volume total, à gauche des totaux -->
        <xpath expr="//div[@id='total']/div" position="attributes">
            <attribute name="class" add="col-6 ms-auto" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='total']/div" position="before">
            <div class="col-6">
                <i t-if="doc.is_volume_total>0">Volume total : <span t-out="round(doc.is_volume_total,3)"/> m3</i>
            </div>
        </xpath>

        <!-- Conditions générales de vente, après le devis -->
        <xpath expr="//div[hasclass('page')]" position="after">
            <t t-call="is_jurabotec20.conditions_generales_de_vente"/>
        </xpath>
    </template>
</odoo>
