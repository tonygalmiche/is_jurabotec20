<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Migration v20 : la page de la facture v16 (remplacée en entier) est abandonnée au profit de la facture
             standard (mentions obligatoires françaises de l10n_fr_account, Factur-X), complétée ici avec les mêmes
             ajouts et les mêmes éléments masqués qu'en v16 -->
        <template id="is_report_invoice_document" inherit_id="account.report_invoice_document">
            <!-- Styles du rapport (report.scss) -->
            <xpath expr="//div[hasclass('page')]" position="attributes">
                <attribute name="class" add="jurabotec" separator=" "/>
            </xpath>

            <!-- Masqués en v16 : origine, code client, référence -->
            <xpath expr="//div[@name='origin']" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>
            <xpath expr="//div[@name='customer_code']" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>
            <xpath expr="//div[@name='reference']" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>

            <!-- Masquée en v16 : colonne TVA -->
            <xpath expr="//t[@t-set='display_taxes']" position="attributes">
                <attribute name="t-value">False</attribute>
            </xpath>

            <!-- Détail des lignes de commande -->
            <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
                <t t-foreach="line.sale_line_ids" t-as="sale_line">
                    <div t-if="sale_line.is_detail_quantite"  t-field="sale_line.is_detail_quantite"/>
                    <div t-if="sale_line.is_prix_tarif and sale_line.is_unite_tarif and sale_line.is_unite_tarif!='unite'">
                        Soit <span t-field="sale_line.is_prix_tarif"/> € HT / <span t-field="sale_line.is_unite_tarif"/>
                    </div>
                    <div t-if="sale_line.is_eco_contribution"><i>(Eco-contribution de <span t-field="sale_line.is_eco_contribution"/>)</i></div>
                </t>
            </xpath>

            <!-- Volume total, à gauche des totaux -->
            <xpath expr="//div[@id='right-elements']" position="before">
                <div class="float-start">
                    <i>Volume total : <span t-out="round(o.is_volume_total,3)"/> m3</i>
                </div>
            </xpath>

            <!-- Masqués en v16 : échéancier, communication de paiement, QR code, note (narration) -->
            <xpath expr="//div[@id='total_payment_term_details_table']" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>
            <xpath expr="//p[@name='payment_communication']" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>
            <xpath expr="//t[@t-set='show_qr']" position="attributes">
                <attribute name="t-value">False</attribute>
            </xpath>
            <xpath expr="//div[@name='comment']" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>

            <!-- Coordonnées bancaires -->
            <xpath expr="//div[@id='payment_term']" position="inside">
                <strong>Pour notre règlement par virement : </strong>
                <p t-foreach="company.partner_id.bank_ids" t-as="bank">
                    IBAN : <span t-field="bank.acc_number" /> -  BIC : <span t-field="bank.bank_id.bic" />
                </p>
            </xpath>

            <!-- Conditions générales de vente, après la facture -->
            <xpath expr="//div[hasclass('invoice_main')]" position="after">
                <t t-call="is_jurabotec20.conditions_generales_de_vente" />
            </xpath>
        </template>
    </data>
</odoo>
